<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Swarm Manager</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container mt-4">
  <h2>Panel de gestión Swarm</h2>
  <hr>

  <h4>Nodos</h4>
  <table class="table table-bordered table-sm" id="tabla-nodos">
    <thead class="table-dark">
      <tr><th>Nombre</th><th>Rol</th><th>Estado</th></tr>
    </thead>
    <tbody></tbody>
  </table>

  <h4 class="mt-4">Servicios</h4>
  <p class="text-muted">Haz clic en un servicio para ver sus tareas</p>
  <table class="table table-bordered table-sm" id="tabla-servicios">
    <thead class="table-dark">
      <tr><th>Nombre</th><th>Imagen</th><th>Réplicas</th></tr>
    </thead>
   <tbody></tbody>
  </table>

  <div id="detalle" class="mt-3" style="display:none">
    <h5>Tareas de: <span id="detalle-nombre"></span></h5>
    <table class="table table-bordered table-sm" id="tabla-tareas">
      <thead class="table-secondary">
        <tr><th>ID</th><th>Nodo</th><th>Estado</th><th>Error</th></tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<script>
fetch('/api/data')
  .then(r => r.json())
  .then(data => {
    const nodos = document.querySelector('#tabla-nodos tbody');
    data.nodes.forEach(n => {
      nodos.innerHTML += `<tr><td>${n.hostname}</td><td>${n.role}</td><td>${n.status}</td></tr>`;
    });

    const servicios = document.querySelector('#tabla-servicios tbody');
    data.services.forEach(s => {
      const tr = document.createElement('tr');

      tr.style.cursor = 'pointer';
      tr.innerHTML = `<td>${s.name}</td><td>${s.image}</td><td>${s.replicas}</td>`;
      tr.addEventListener('click', () => cargarTareas(s.id, s.name));
      servicios.appendChild(tr);
    });
  });

function cargarTareas(id, nombre) {
  fetch(`/api/tasks/${id}`)
    .then(r => r.json())
    .then(tasks => {
      document.getElementById('detalle').style.display = 'block';
      document.getElementById('detalle-nombre').textContent = nombre;
      const tbody = document.querySelector('#tabla-tareas tbody');
      tbody.innerHTML = '';
      tasks.forEach(t => {
        tbody.innerHTML += `<tr><td>${t.id}</td><td>${t.node}</td><td>${t.state}</td><td>${t.error}</td></tr>`;
      });
    });
}
</script>
</body>
</html>

